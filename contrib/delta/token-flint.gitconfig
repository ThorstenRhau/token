# Generated by token colorscheme. Do not edit manually.
# Include this file from ~/.gitconfig, then enable one of these named delta features:
#   [delta]
#     features = token-flint-dark

[delta "token-flint-dark"]
	dark = true
	syntax-theme = token-flint-dark
	blame-palette = "#1C2127 #22272E #272C33 #30363E #373E47"
	commit-decoration-style = "#626C77" bold box ul
	file-style = "#DCE1E6"
	file-decoration-style = "#626C77"
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#626C77" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#929BA5"
	line-numbers-left-style = "#626C77"
	line-numbers-right-style = "#626C77"
	line-numbers-minus-style = bold "#D47A7F"
	line-numbers-plus-style = bold "#94A477"
	line-numbers-zero-style = "#929BA5"
	minus-style = syntax "#4A3035"
	minus-non-emph-style = syntax "#4A3035"
	minus-emph-style = bold "#DCE1E6" "#613940"
	minus-empty-line-marker-style = syntax "#4A3035"
	plus-style = syntax "#364338"
	plus-non-emph-style = syntax "#364338"
	plus-emph-style = bold "#DCE1E6" "#455746"
	plus-empty-line-marker-style = syntax "#364338"
	map-styles = "bold purple => syntax '#494231', bold cyan => syntax '#494231'"

[delta "token-flint-light"]
	light = true
	syntax-theme = token-flint-light
	blame-palette = "#E7EBEF #EEF1F3 #F5F7F8 #EBEFF2 #E0E5EA"
	commit-decoration-style = "#828E9A" bold box ul
	file-style = "#28313A"
	file-decoration-style = "#828E9A"
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#828E9A" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#65717D"
	line-numbers-left-style = "#828E9A"
	line-numbers-right-style = "#828E9A"
	line-numbers-minus-style = bold "#BE3E50"
	line-numbers-plus-style = bold "#5A772B"
	line-numbers-zero-style = "#65717D"
	minus-style = syntax "#F2DEE1"
	minus-non-emph-style = syntax "#F2DEE1"
	minus-emph-style = bold "#28313A" "#E7C8CD"
	minus-empty-line-marker-style = syntax "#F2DEE1"
	plus-style = syntax "#E1E9D9"
	plus-non-emph-style = syntax "#E1E9D9"
	plus-emph-style = bold "#28313A" "#CCDABF"
	plus-empty-line-marker-style = syntax "#E1E9D9"
	map-styles = "bold purple => syntax '#ECE5D5', bold cyan => syntax '#ECE5D5'"
