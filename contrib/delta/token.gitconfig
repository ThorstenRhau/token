# Generated by token colorscheme. Do not edit manually.
# Include this file from ~/.gitconfig, then enable one of these named delta features:
#   [delta]
#     features = token-dark

[delta "token-dark"]
	dark = true
	syntax-theme = token-dark
	blame-palette = "#1d1d1c #212120 #262624 #2f2f2d #383835"
	commit-decoration-style = "#8a8884" bold box ul
	file-style = "#c3c0b8"
	file-decoration-style = "#8a8884"
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#8a8884" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#a19c94"
	line-numbers-left-style = "#8a8884"
	line-numbers-right-style = "#8a8884"
	line-numbers-minus-style = bold "#d68585"
	line-numbers-plus-style = bold "#8fb78c"
	line-numbers-zero-style = "#a19c94"
	minus-style = syntax "#5a2529"
	minus-non-emph-style = syntax "#5a2529"
	minus-emph-style = bold "#c3c0b8" "#7a2e34"
	minus-empty-line-marker-style = syntax "#5a2529"
	plus-style = syntax "#2e5232"
	plus-non-emph-style = syntax "#2e5232"
	plus-emph-style = bold "#c3c0b8" "#3a6e3e"
	plus-empty-line-marker-style = syntax "#2e5232"
	map-styles = "bold purple => syntax '#444039', bold cyan => syntax '#444039'"

[delta "token-light"]
	light = true
	syntax-theme = token-light
	blame-palette = "#ecebe7 #f6f5f1 #faf9f5 #f0efeb #eae9e5"
	commit-decoration-style = "#524e46" bold box ul
	file-style = "#323128"
	file-decoration-style = "#524e46"
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#524e46" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#504b44"
	line-numbers-left-style = "#524e46"
	line-numbers-right-style = "#524e46"
	line-numbers-minus-style = bold "#ad5253"
	line-numbers-plus-style = bold "#365a33"
	line-numbers-zero-style = "#504b44"
	minus-style = syntax "#ffdada"
	minus-non-emph-style = syntax "#ffdada"
	minus-emph-style = bold "#323128" "#e8c4c4"
	minus-empty-line-marker-style = syntax "#ffdada"
	plus-style = syntax "#daf6d5"
	plus-non-emph-style = syntax "#daf6d5"
	plus-emph-style = bold "#323128" "#c0d8bc"
	plus-empty-line-marker-style = syntax "#daf6d5"
	map-styles = "bold purple => syntax '#eee4c6', bold cyan => syntax '#eee4c6'"
