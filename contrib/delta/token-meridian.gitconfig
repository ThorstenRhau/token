# Generated by token colorscheme. Do not edit manually.
# Include this file from ~/.gitconfig, then enable one of these named delta features:
#   [delta]
#     features = token-meridian-dark

[delta "token-meridian-dark"]
	dark = true
	syntax-theme = token-meridian-dark
	blame-palette = "#1d1d1c #212120 #272724 #30302c #383835"
	commit-decoration-style = "#91887d" bold box ul
	file-style = "#c9c0b1"
	file-decoration-style = "#91887d"
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#91887d" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#a69c91"
	line-numbers-left-style = "#91887d"
	line-numbers-right-style = "#91887d"
	line-numbers-minus-style = bold "#db8935"
	line-numbers-plus-style = bold "#8cbb62"
	line-numbers-zero-style = "#a69c91"
	minus-style = syntax "#5a2529"
	minus-non-emph-style = syntax "#5a2529"
	minus-emph-style = bold "#c9c0b1" "#7a2e34"
	minus-empty-line-marker-style = syntax "#5a2529"
	plus-style = syntax "#2e5232"
	plus-non-emph-style = syntax "#2e5232"
	plus-emph-style = bold "#c9c0b1" "#3a6e3e"
	plus-empty-line-marker-style = syntax "#2e5232"
	map-styles = "bold purple => syntax '#444039', bold cyan => syntax '#444039'"

[delta "token-meridian-light"]
	light = true
	syntax-theme = token-meridian-light
	blame-palette = "#ecebe7 #f6f5f1 #fbf9f4 #f0ede6 #eae9e5"
	commit-decoration-style = "#43505c" bold box ul
	file-style = "#28323a"
	file-decoration-style = "#43505c"
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#43505c" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#524b42"
	line-numbers-left-style = "#43505c"
	line-numbers-right-style = "#43505c"
	line-numbers-minus-style = bold "#286fc0"
	line-numbers-plus-style = bold "#005f2f"
	line-numbers-zero-style = "#524b42"
	minus-style = syntax "#ffdada"
	minus-non-emph-style = syntax "#ffdada"
	minus-emph-style = bold "#28323a" "#e8c4c4"
	minus-empty-line-marker-style = syntax "#ffdada"
	plus-style = syntax "#daf6d5"
	plus-non-emph-style = syntax "#daf6d5"
	plus-emph-style = bold "#28323a" "#c0d8bc"
	plus-empty-line-marker-style = syntax "#daf6d5"
	map-styles = "bold purple => syntax '#eee4c6', bold cyan => syntax '#eee4c6'"
