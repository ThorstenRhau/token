# Generated by token colorscheme. Do not edit manually.
# Include this file from ~/.gitconfig, then enable one of these named delta features:
#   [delta]
#     features = token-melange-dark

[delta "token-melange-dark"]
	dark = true
	syntax-theme = token-melange-dark
	blame-palette = "#221f1c #25221f #292522 #34302c #3b3632"
	commit-decoration-style = "#988573" bold box ul
	file-style = "#c9beb2"
	file-decoration-style = "#988573"
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#988573" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#af997d"
	merge-conflict-ours-diff-header-style = bold "#af997d"
	merge-conflict-ours-diff-header-decoration-style = "#988573" box
	merge-conflict-theirs-diff-header-style = bold "#af997d"
	merge-conflict-theirs-diff-header-decoration-style = "#988573" box
	line-numbers-left-style = "#988573"
	line-numbers-right-style = "#988573"
	line-numbers-minus-style = bold "#c88b8f"
	line-numbers-plus-style = bold "#84b894"
	line-numbers-zero-style = "#af997d"
	minus-style = syntax "#56282c"
	minus-non-emph-style = syntax "#56282c"
	minus-emph-style = bold "#c9beb2" "#7d2a2f"
	minus-empty-line-marker-style = syntax "#56282c"
	plus-style = syntax "#2f4a31"
	plus-non-emph-style = syntax "#2f4a31"
	plus-emph-style = bold "#c9beb2" "#3d633f"
	plus-empty-line-marker-style = syntax "#2f4a31"
	map-styles = "bold purple => syntax '#422741', bold cyan => syntax '#422741'"

[delta "token-melange-light"]
	light = true
	syntax-theme = token-melange-light
	blame-palette = "#e8e4e0 #eeedeb #f1f1f1 #e9e1db #e3ddd8"
	commit-decoration-style = "#7f6254" bold box ul
	file-style = "#39281f"
	file-decoration-style = "#7f6254"
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#7f6254" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#735c4c"
	merge-conflict-ours-diff-header-style = bold "#735c4c"
	merge-conflict-ours-diff-header-decoration-style = "#7f6254" box
	merge-conflict-theirs-diff-header-style = bold "#735c4c"
	merge-conflict-theirs-diff-header-decoration-style = "#7f6254" box
	line-numbers-left-style = "#7f6254"
	line-numbers-right-style = "#7f6254"
	line-numbers-minus-style = bold "#9c5364"
	line-numbers-plus-style = bold "#2a563c"
	line-numbers-zero-style = "#735c4c"
	minus-style = syntax "#f1dedf"
	minus-non-emph-style = syntax "#f1dedf"
	minus-emph-style = bold "#39281f" "#e5c3c5"
	minus-empty-line-marker-style = syntax "#f1dedf"
	plus-style = syntax "#d0e9d1"
	plus-non-emph-style = syntax "#d0e9d1"
	plus-emph-style = bold "#39281f" "#b5d9b7"
	plus-empty-line-marker-style = syntax "#d0e9d1"
	map-styles = "bold purple => syntax '#e8e0e8', bold cyan => syntax '#e8e0e8'"
