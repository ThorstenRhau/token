# Generated by token colorscheme. Do not edit manually.
# Include this file from ~/.gitconfig, then enable one of these named delta features:
#   [delta]
#     features = token-ultra-dark

[delta "token-ultra-dark"]
	dark = true
	syntax-theme = token-ultra-dark
	blame-palette = "#1d1d1c #212120 #272724 #30302c #383835"
	commit-decoration-style = "#8d8983" bold box ul
	file-style = "#c5c1b8"
	file-decoration-style = "#8d8983"
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#8d8983" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#a39d94"
	line-numbers-left-style = "#8d8983"
	line-numbers-right-style = "#8d8983"
	line-numbers-minus-style = bold "#dd8384"
	line-numbers-plus-style = bold "#9ab58e"
	line-numbers-zero-style = "#a39d94"
	minus-style = syntax "#5a2529"
	minus-non-emph-style = syntax "#5a2529"
	minus-emph-style = bold "#c5c1b8" "#7a2e34"
	minus-empty-line-marker-style = syntax "#5a2529"
	plus-style = syntax "#2e5232"
	plus-non-emph-style = syntax "#2e5232"
	plus-emph-style = bold "#c5c1b8" "#3a6e3e"
	plus-empty-line-marker-style = syntax "#2e5232"
	map-styles = "bold purple => syntax '#444039', bold cyan => syntax '#444039'"

[delta "token-ultra-light"]
	light = true
	syntax-theme = token-ultra-light
	blame-palette = "#ecebe7 #f6f5f1 #fbf9f4 #f0ede6 #eae9e5"
	commit-decoration-style = "#544e44" bold box ul
	file-style = "#31312b"
	file-decoration-style = "#544e44"
	hunk-header-style = file line-number syntax
	hunk-header-decoration-style = "#544e44" box ul
	hunk-header-file-style = bold
	hunk-header-line-number-style = bold "#514b44"
	line-numbers-left-style = "#544e44"
	line-numbers-right-style = "#544e44"
	line-numbers-minus-style = bold "#ae5158"
	line-numbers-plus-style = bold "#385a35"
	line-numbers-zero-style = "#514b44"
	minus-style = syntax "#ffdada"
	minus-non-emph-style = syntax "#ffdada"
	minus-emph-style = bold "#31312b" "#e8c4c4"
	minus-empty-line-marker-style = syntax "#ffdada"
	plus-style = syntax "#daf6d5"
	plus-non-emph-style = syntax "#daf6d5"
	plus-emph-style = bold "#31312b" "#c0d8bc"
	plus-empty-line-marker-style = syntax "#daf6d5"
	map-styles = "bold purple => syntax '#eee4c6', bold cyan => syntax '#eee4c6'"
