  "tokenColors": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#a19c94",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword, keyword.control, keyword.other",
      "settings": {
        "foreground": "#f7c699",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage",
      "scope": "storage, storage.modifier",
      "settings": {
        "foreground": "#f7c699",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operator",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#a6a198"
      }
    },
    {
      "name": "Function",
      "scope": "entity.name.function, support.function, meta.function-call",
      "settings": {
        "foreground": "#f4906f"
      }
    },
    {
      "name": "String",
      "scope": "string, punctuation.definition.string",
      "settings": {
        "foreground": "#8fb78c"
      }
    },
    {
      "name": "String escape",
      "scope": "constant.character.escape",
      "settings": {
        "foreground": "#b195ca"
      }
    },
    {
      "name": "Boolean",
      "scope": "constant.language.boolean",
      "settings": {
        "foreground": "#f7c699"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric",
      "settings": {
        "foreground": "#b195ca"
      }
    },
    {
      "name": "Constant",
      "scope": "constant, constant.language, support.constant, variable.other.constant",
      "settings": {
        "foreground": "#b195ca"
      }
    },
    {
      "name": "Type",
      "scope": "storage.type, support.type, entity.name.type, entity.other.inherited-class",
      "settings": {
        "foreground": "#81a5c4"
      }
    },
    {
      "name": "Class",
      "scope": "entity.name.type.class, support.class, entity.name.class",
      "settings": {
        "foreground": "#81a5c4"
      }
    },
    {
      "name": "Module",
      "scope": "entity.name.namespace, entity.name.type.module, support.module",
      "settings": {
        "foreground": "#81a5c4"
      }
    },
    {
      "name": "PreProc",
      "scope": "keyword.control.import, keyword.control.export, keyword.control.directive, keyword.preprocessor",
      "settings": {
        "foreground": "#b195ca",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Include",
      "scope": "keyword.other.import, keyword.other.package, keyword.other.using",
      "settings": {
        "foreground": "#b195ca",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Macro",
      "scope": "entity.name.function.preprocessor",
      "settings": {
        "foreground": "#b195ca",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tag",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#b195ca"
      }
    },
    {
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#f7c699"
      }
    },
    {
      "name": "Attribute",
      "scope": "meta.annotation, storage.type.annotation",
      "settings": {
        "foreground": "#b195ca"
      }
    },
    {
      "name": "Label",
      "scope": "entity.name.label, constant.other.label",
      "settings": {
        "foreground": "#f7c699",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Special",
      "scope": "variable.language, constant.language.null, constant.language.undefined",
      "settings": {
        "foreground": "#b195ca"
      }
    },
    {
      "name": "Debug",
      "scope": "keyword.other.debugger",
      "settings": {
        "foreground": "#d68585",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Exception",
      "scope": "keyword.control.exception, keyword.control.trycatch",
      "settings": {
        "foreground": "#d68585",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Identifier",
      "scope": "variable, support.variable, meta.definition.variable",
      "settings": {
        "foreground": "#c3c0b8"
      }
    },
    {
      "name": "Property",
      "scope": "variable.object.property, variable.other.property, variable.other.member, meta.object-literal.key",
      "settings": {
        "foreground": "#c3c0b8"
      }
    },
    {
      "name": "Delimiter",
      "scope": "punctuation, meta.brace, meta.delimiter, meta.bracket",
      "settings": {
        "foreground": "#a6a198"
      }
    },
    {
      "name": "Parameter",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#a6a198"
      }
    },
    {
      "name": "Heading 1",
      "scope": "heading.1.markdown, markup.heading.setext.1.markdown",
      "settings": {
        "foreground": "#f4906f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 2",
      "scope": "heading.2.markdown, markup.heading.setext.2.markdown",
      "settings": {
        "foreground": "#f7c699",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 3",
      "scope": "heading.3.markdown",
      "settings": {
        "foreground": "#b99d4a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 4",
      "scope": "heading.4.markdown",
      "settings": {
        "foreground": "#81a5c4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 5",
      "scope": "heading.5.markdown",
      "settings": {
        "foreground": "#8fb78c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 6",
      "scope": "heading.6.markdown",
      "settings": {
        "foreground": "#b195ca",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading delimiter",
      "scope": "punctuation.definition.heading.markdown",
      "settings": {
        "foreground": "#a19c94"
      }
    },
    {
      "name": "Markup link",
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#81a5c4",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup link text",
      "scope": "string.other.link.title.markdown, constant.other.reference.link.markdown",
      "settings": {
        "foreground": "#81a5c4",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup code",
      "scope": "markup.fenced_code.block.markdown, markup.inline.raw.string.markdown, markup.raw",
      "settings": {
        "foreground": "#8fb78c"
      }
    },
    {
      "name": "Markup code delimiter",
      "scope": "punctuation.definition.markdown, punctuation.definition.raw.markdown",
      "settings": {
        "foreground": "#a19c94"
      }
    },
    {
      "name": "Markup list",
      "scope": "punctuation.definition.list.begin.markdown, markup.list",
      "settings": {
        "foreground": "#f7c699",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup bold italic",
      "scope": "markup.bold markup.italic, markup.italic markup.bold",
      "settings": {
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Markup quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#a19c94",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff added",
      "scope": "markup.inserted, meta.diff.header.to-file",
      "settings": {
        "foreground": "#8fb78c"
      }
    },
    {
      "name": "Diff deleted",
      "scope": "markup.deleted, meta.diff.header.from-file",
      "settings": {
        "foreground": "#d68585"
      }
    },
    {
      "name": "Diff changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#b99d4a"
      }
    },
    {
      "name": "GitGutter inserted",
      "scope": "markup.inserted.git_gutter",
      "settings": {
        "foreground": "#8fb78c"
      }
    },
    {
      "name": "GitGutter deleted",
      "scope": "markup.deleted.git_gutter",
      "settings": {
        "foreground": "#d68585"
      }
    },
    {
      "name": "GitGutter changed",
      "scope": "markup.changed.git_gutter",
      "settings": {
        "foreground": "#b99d4a"
      }
    },
    {
      "name": "GitGutter untracked",
      "scope": "markup.untracked.git_gutter",
      "settings": {
        "foreground": "#8a8884"
      }
    },
    {
      "name": "GitGutter ignored",
      "scope": "markup.ignored.git_gutter",
      "settings": {
        "foreground": "#8a8884"
      }
    }
  ],
