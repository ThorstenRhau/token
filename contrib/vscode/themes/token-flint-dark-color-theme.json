  "tokenColors": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#9aa4ae",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword, keyword.control, keyword.other, storage.modifier",
      "settings": {
        "foreground": "#f8d28a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Declaration keyword",
      "scope": "storage.type.function, storage.type.class, storage.type.interface, storage.type.enum, storage.type.struct, storage.type.type, storage.type.namespace, storage.type.keyword, storage.type.ts, storage.type.tsx, storage.type.js, storage.type.rust",
      "settings": {
        "foreground": "#f8d28a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operator",
      "scope": "keyword.operator, storage.type.function.arrow",
      "settings": {
        "foreground": "#afb6bc",
        "fontStyle": ""
      }
    },
    {
      "name": "Word operator",
      "scope": "keyword.operator.word, keyword.operator.logical.python, keyword.operator.expression, keyword.operator.new",
      "settings": {
        "foreground": "#afb6bc",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function definition",
      "scope": "entity.name.function, meta.function.definition entity.name",
      "settings": {
        "foreground": "#eb9e83",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function call",
      "scope": "meta.function-call, variable.function, meta.function-call entity.name.function, meta.function.call entity.name.function, meta.method-call entity.name.function, entity.name.function.call, entity.name.function.support, entity.name.function.decorator, entity.name.function.macro, entity.name.function.tagged-template",
      "settings": {
        "foreground": "#eb9e83",
        "fontStyle": ""
      }
    },
    {
      "name": "Built-in function",
      "scope": "support.function",
      "settings": {
        "foreground": "#afb6bc",
        "fontStyle": ""
      }
    },
    {
      "name": "String",
      "scope": "string, punctuation.definition.string",
      "settings": {
        "foreground": "#a9b98c",
        "fontStyle": ""
      }
    },
    {
      "name": "Docstring",
      "scope": "string.quoted.docstring, string.quoted.docstring punctuation.definition.string",
      "settings": {
        "foreground": "#9aa4ae",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Literal",
      "scope": "constant, constant.language, constant.numeric, variable.other.constant",
      "settings": {
        "foreground": "#a9b98c",
        "fontStyle": ""
      }
    },
    {
      "name": "Type definition",
      "scope": "entity.name.type.class, entity.name.type.interface, entity.name.type.struct, entity.name.type.enum, entity.name.type.alias, entity.name.class, entity.name.struct, entity.name.interface, entity.name.enum",
      "settings": {
        "foreground": "#eb9e83",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Type reference",
      "scope": "entity.name.type, storage.type, support.type, support.class, entity.other.inherited-class",
      "settings": {
        "foreground": "#afb6bc",
        "fontStyle": ""
      }
    },
    {
      "name": "Module",
      "scope": "entity.name.namespace, entity.name.type.module, support.module",
      "settings": {
        "foreground": "#afb6bc",
        "fontStyle": ""
      }
    },
    {
      "name": "Preprocessor",
      "scope": "keyword.control.import, keyword.control.export, keyword.control.directive, keyword.preprocessor, keyword.other.import, keyword.other.package, keyword.other.using",
      "settings": {
        "foreground": "#f8d28a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Macro",
      "scope": "entity.name.function.preprocessor",
      "settings": {
        "foreground": "#f8d28a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tag",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#afb6bc",
        "fontStyle": ""
      }
    },
    {
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#c3c8cc",
        "fontStyle": ""
      }
    },
    {
      "name": "Attribute",
      "scope": "meta.annotation, storage.type.annotation",
      "settings": {
        "foreground": "#afb6bc",
        "fontStyle": ""
      }
    },
    {
      "name": "Label",
      "scope": "entity.name.label, constant.other.label",
      "settings": {
        "foreground": "#f8d28a",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Built-in symbol",
      "scope": "variable.language",
      "settings": {
        "foreground": "#afb6bc",
        "fontStyle": ""
      }
    },
    {
      "name": "Debug",
      "scope": "keyword.other.debugger",
      "settings": {
        "foreground": "#e3888c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Exception",
      "scope": "keyword.control.exception, keyword.control.trycatch",
      "settings": {
        "foreground": "#e3888c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Identifier",
      "scope": "variable, support.variable, meta.definition.variable",
      "settings": {
        "foreground": "#c3c8cc",
        "fontStyle": ""
      }
    },
    {
      "name": "Property",
      "scope": "variable.object.property, variable.other.property, variable.other.member, meta.object-literal.key",
      "settings": {
        "foreground": "#c59ab2",
        "fontStyle": ""
      }
    },
    {
      "name": "Delimiter",
      "scope": "punctuation, meta.brace, meta.delimiter, meta.bracket",
      "settings": {
        "foreground": "#9aa4ae",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameter",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#afb6bc",
        "fontStyle": ""
      }
    },
    {
