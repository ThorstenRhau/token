  "tokenColors": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#735c4c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword, keyword.control, keyword.other, storage.modifier",
      "settings": {
        "foreground": "#773a03",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Declaration keyword",
      "scope": "storage.type.function, storage.type.class, storage.type.interface, storage.type.enum, storage.type.struct, storage.type.type, storage.type.namespace, storage.type.keyword, storage.type.ts, storage.type.tsx, storage.type.js, storage.type.rust",
      "settings": {
        "foreground": "#773a03",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operator",
      "scope": "keyword.operator, storage.type.function.arrow",
      "settings": {
        "foreground": "#ac0a1f",
        "fontStyle": ""
      }
    },
    {
      "name": "Word operator",
      "scope": "keyword.operator.word, keyword.operator.logical.python, keyword.operator.expression, keyword.operator.new",
      "settings": {
        "foreground": "#ac0a1f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function definition",
      "scope": "entity.name.function, meta.function.definition entity.name",
      "settings": {
        "foreground": "#634f00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function call",
      "scope": "meta.function-call, variable.function, meta.function-call entity.name.function, meta.function.call entity.name.function, meta.method-call entity.name.function, entity.name.function.call, entity.name.function.support, entity.name.function.decorator, entity.name.function.macro, entity.name.function.tagged-template",
      "settings": {
        "foreground": "#634f00",
        "fontStyle": ""
      }
    },
    {
      "name": "Built-in function",
      "scope": "support.function",
      "settings": {
        "foreground": "#355b60",
        "fontStyle": ""
      }
    },
    {
      "name": "String",
      "scope": "string, punctuation.definition.string",
      "settings": {
        "foreground": "#3b5198",
        "fontStyle": ""
      }
    },
    {
      "name": "Docstring",
      "scope": "string.quoted.docstring, string.quoted.docstring punctuation.definition.string",
      "settings": {
        "foreground": "#735c4c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Number",
      "scope": "constant.numeric, constant.language.boolean",
      "settings": {
        "foreground": "#843476",
        "fontStyle": ""
      }
    },
    {
      "name": "Literal",
      "scope": "constant, constant.language, variable.other.constant",
      "settings": {
        "foreground": "#3b5198",
        "fontStyle": ""
      }
    },
    {
      "name": "Type definition",
      "scope": "entity.name.type.class, entity.name.type.interface, entity.name.type.struct, entity.name.type.enum, entity.name.type.alias, entity.name.class, entity.name.struct, entity.name.interface, entity.name.enum",
      "settings": {
        "foreground": "#634f00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Type reference",
      "scope": "entity.name.type, storage.type, support.type, support.class, entity.other.inherited-class",
      "settings": {
        "foreground": "#355b60",
        "fontStyle": ""
      }
    },
    {
      "name": "Module",
      "scope": "entity.name.namespace, entity.name.type.module, support.module",
      "settings": {
        "foreground": "#355b60",
        "fontStyle": ""
      }
    },
    {
      "name": "Preprocessor",
      "scope": "keyword.control.import, keyword.control.export, keyword.control.directive, keyword.preprocessor, keyword.other.import, keyword.other.package, keyword.other.using",
      "settings": {
        "foreground": "#773a03",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Macro",
      "scope": "entity.name.function.preprocessor",
      "settings": {
        "foreground": "#773a03",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tag",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#634f00",
        "fontStyle": ""
      }
    },
    {
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#355b60",
        "fontStyle": ""
      }
    },
    {
      "name": "Attribute",
      "scope": "meta.annotation, storage.type.annotation",
      "settings": {
        "foreground": "#2a563c",
        "fontStyle": ""
      }
    },
    {
      "name": "Label",
      "scope": "entity.name.label, constant.other.label",
      "settings": {
        "foreground": "#773a03",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Built-in symbol",
      "scope": "variable.language",
      "settings": {
        "foreground": "#355b60",
        "fontStyle": ""
      }
    },
    {
      "name": "Debug",
      "scope": "keyword.other.debugger",
      "settings": {
        "foreground": "#9c5364",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Exception",
      "scope": "keyword.control.exception, keyword.control.trycatch",
      "settings": {
        "foreground": "#9c5364",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Identifier",
      "scope": "variable, support.variable, meta.definition.variable",
      "settings": {
        "foreground": "#39281f",
        "fontStyle": ""
      }
    },
    {
      "name": "Property",
      "scope": "variable.object.property, variable.other.property, variable.other.member, meta.object-literal.key",
      "settings": {
        "foreground": "#655066",
        "fontStyle": ""
      }
    },
    {
      "name": "Delimiter",
      "scope": "punctuation, meta.brace, meta.delimiter, meta.bracket",
      "settings": {
        "foreground": "#735c4c",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameter",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#594a41",
        "fontStyle": ""
      }
    },
    {
      "name": "Heading 1",
      "scope": "heading.1.markdown, markup.heading.setext.1.markdown",
      "settings": {
        "foreground": "#773a03",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 2",
      "scope": "heading.2.markdown, markup.heading.setext.2.markdown",
      "settings": {
        "foreground": "#634f00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 3",
      "scope": "heading.3.markdown",
      "settings": {
        "foreground": "#2a563c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 4",
      "scope": "heading.4.markdown",
      "settings": {
        "foreground": "#773a03",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 5",
      "scope": "heading.5.markdown",
      "settings": {
        "foreground": "#634f00",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 6",
      "scope": "heading.6.markdown",
      "settings": {
        "foreground": "#2a563c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading delimiter",
      "scope": "punctuation.definition.heading.markdown",
      "settings": {
        "foreground": "#735c4c",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup link",
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#3b5198",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup link text",
      "scope": "string.other.link.title.markdown, constant.other.reference.link.markdown",
      "settings": {
        "foreground": "#3b5198",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup code",
      "scope": "markup.fenced_code.block.markdown, markup.inline.raw.string.markdown, markup.raw",
      "settings": {
        "foreground": "#3b5198",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup code delimiter",
      "scope": "punctuation.definition.markdown, punctuation.definition.raw.markdown",
      "settings": {
        "foreground": "#735c4c",
        "fontStyle": ""
      }
    },
    {
      "name": "Markup list",
      "scope": "punctuation.definition.list.begin.markdown, markup.list",
      "settings": {
        "foreground": "#773a03",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup bold italic",
      "scope": "markup.bold markup.italic, markup.italic markup.bold",
      "settings": {
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Markup quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#735c4c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff added",
      "scope": "markup.inserted, meta.diff.header.to-file",
      "settings": {
        "foreground": "#2a563c",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff deleted",
      "scope": "markup.deleted, meta.diff.header.from-file",
      "settings": {
        "foreground": "#9c5364",
        "fontStyle": ""
      }
    },
    {
      "name": "Diff changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#8d5e02",
        "fontStyle": ""
      }
    },
    {
      "name": "GitGutter inserted",
      "scope": "markup.inserted.git_gutter",
      "settings": {
        "foreground": "#2a563c",
        "fontStyle": ""
      }
    },
    {
      "name": "GitGutter deleted",
      "scope": "markup.deleted.git_gutter",
      "settings": {
        "foreground": "#9c5364",
        "fontStyle": ""
      }
    },
    {
      "name": "GitGutter changed",
      "scope": "markup.changed.git_gutter",
      "settings": {
        "foreground": "#8d5e02",
        "fontStyle": ""
      }
    },
    {
      "name": "GitGutter untracked",
      "scope": "markup.untracked.git_gutter",
      "settings": {
        "foreground": "#7f6254",
        "fontStyle": ""
      }
    },
    {
      "name": "GitGutter ignored",
      "scope": "markup.ignored.git_gutter",
      "settings": {
        "foreground": "#7f6254",
        "fontStyle": ""
      }
    }
