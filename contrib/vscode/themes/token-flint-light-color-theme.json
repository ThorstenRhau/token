    "terminal.ansiRed": "#BF3F50",
    "terminal.ansiGreen": "#3D5902",
    "terminal.ansiYellow": "#996914",
    "terminal.ansiBlue": "#035378",
    "terminal.ansiMagenta": "#852500",
    "terminal.ansiCyan": "#09567B",
    "terminal.ansiWhite": "#A7B2BB",
    "terminal.ansiBrightBlack": "#414C57",
    "terminal.ansiBrightRed": "#902A03",
    "terminal.ansiBrightGreen": "#2F4900",
    "terminal.ansiBrightYellow": "#6b4600",
    "terminal.ansiBrightBlue": "#0C557A",
    "terminal.ansiBrightMagenta": "#A13C20",
    "terminal.ansiBrightCyan": "#2C6E94",
    "terminal.ansiBrightWhite": "#F5F7F8"
