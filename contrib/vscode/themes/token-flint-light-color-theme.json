    "titleBar.activeForeground": "#283039",
    "titleBar.inactiveBackground": "#E7EBEF",
    "titleBar.inactiveForeground": "#414C57",
    "tab.activeBackground": "#F5F7F8",
    "tab.activeForeground": "#283039",
    "tab.inactiveBackground": "#EEF1F3",
    "tab.inactiveForeground": "#414C57",
    "tab.border": "#EEF1F3",
    "terminal.background": "#F5F7F8",
    "terminal.foreground": "#283039",
    "terminalCursor.foreground": "#283039",
    "terminal.selectionBackground": "#DCE2E7",
