  "tokenColors": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#6d675f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword, keyword.control, keyword.other, storage.modifier",
      "settings": {
        "foreground": "#87601b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operator",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#3d3929"
      }
    },
    {
      "name": "Function definition",
      "scope": "entity.name.function, meta.function.definition entity.name",
      "settings": {
        "foreground": "#a44e31"
      }
    },
    {
      "name": "Function call",
      "scope": "meta.function-call, variable.function",
      "settings": {
        "foreground": "#a44e31"
      }
    },
    {
      "name": "Built-in function",
      "scope": "support.function",
      "settings": {
        "foreground": "#3d3929"
      }
    },
    {
      "name": "String",
      "scope": "string, punctuation.definition.string",
      "settings": {
        "foreground": "#2c706a"
      }
    },
    {
      "name": "Literal",
      "scope": "constant, constant.language, constant.numeric, variable.other.constant",
      "settings": {
        "foreground": "#2c706a"
      }
    },
    {
      "name": "Type definition",
      "scope": "entity.name.type, entity.name.class, entity.name.type.class",
      "settings": {
        "foreground": "#a44e31"
      }
    },
    {
      "name": "Type reference",
      "scope": "storage.type, support.type, support.class, entity.other.inherited-class",
      "settings": {
        "foreground": "#3d3929"
      }
    },
    {
      "name": "Module",
      "scope": "entity.name.namespace, entity.name.type.module, support.module",
      "settings": {
        "foreground": "#3d3929"
      }
    },
    {
      "name": "Preprocessor",
      "scope": "keyword.control.import, keyword.control.export, keyword.control.directive, keyword.preprocessor, keyword.other.import, keyword.other.package, keyword.other.using",
      "settings": {
        "foreground": "#87601b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Macro",
      "scope": "entity.name.function.preprocessor",
      "settings": {
        "foreground": "#87601b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Tag",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#3d3929"
      }
    },
    {
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#3d3929"
      }
    },
    {
      "name": "Attribute",
      "scope": "meta.annotation, storage.type.annotation",
      "settings": {
        "foreground": "#3d3929"
      }
    },
    {
      "name": "Label",
      "scope": "entity.name.label, constant.other.label",
      "settings": {
        "foreground": "#87601b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Built-in symbol",
      "scope": "variable.language",
      "settings": {
        "foreground": "#3d3929"
      }
    },
    {
      "name": "Debug",
      "scope": "keyword.other.debugger",
      "settings": {
        "foreground": "#87601b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Exception",
      "scope": "keyword.control.exception, keyword.control.trycatch",
      "settings": {
        "foreground": "#87601b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Identifier",
      "scope": "variable, support.variable, meta.definition.variable",
      "settings": {
        "foreground": "#292a24"
      }
    },
    {
      "name": "Property",
      "scope": "variable.object.property, variable.other.property, variable.other.member, meta.object-literal.key",
      "settings": {
        "foreground": "#292a24"
      }
    },
    {
      "name": "Delimiter",
      "scope": "punctuation, meta.brace, meta.delimiter, meta.bracket",
      "settings": {
        "foreground": "#3d3929"
      }
    },
    {
      "name": "Parameter",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#3d3929"
      }
    },
    {
      "name": "Heading 1",
      "scope": "heading.1.markdown, markup.heading.setext.1.markdown",
      "settings": {
        "foreground": "#a44e31",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 2",
      "scope": "heading.2.markdown, markup.heading.setext.2.markdown",
      "settings": {
        "foreground": "#87601b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 3",
      "scope": "heading.3.markdown",
      "settings": {
        "foreground": "#536f88",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 4",
      "scope": "heading.4.markdown",
      "settings": {
        "foreground": "#a44e31",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 5",
      "scope": "heading.5.markdown",
      "settings": {
        "foreground": "#87601b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 6",
      "scope": "heading.6.markdown",
      "settings": {
        "foreground": "#536f88",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading delimiter",
      "scope": "punctuation.definition.heading.markdown",
      "settings": {
        "foreground": "#6d675f"
      }
    },
    {
      "name": "Markup link",
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#536f88",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup link text",
      "scope": "string.other.link.title.markdown, constant.other.reference.link.markdown",
      "settings": {
        "foreground": "#536f88",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup code",
      "scope": "markup.fenced_code.block.markdown, markup.inline.raw.string.markdown, markup.raw",
      "settings": {
        "foreground": "#2c706a"
      }
    },
    {
      "name": "Markup code delimiter",
      "scope": "punctuation.definition.markdown, punctuation.definition.raw.markdown",
      "settings": {
        "foreground": "#6d675f"
      }
    },
    {
      "name": "Markup list",
      "scope": "punctuation.definition.list.begin.markdown, markup.list",
      "settings": {
        "foreground": "#87601b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup bold italic",
      "scope": "markup.bold markup.italic, markup.italic markup.bold",
      "settings": {
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Markup quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#6d675f",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff added",
      "scope": "markup.inserted, meta.diff.header.to-file",
      "settings": {
        "foreground": "#4f714b"
      }
    },
    {
      "name": "Diff deleted",
      "scope": "markup.deleted, meta.diff.header.from-file",
      "settings": {
        "foreground": "#aa4e55"
      }
    },
    {
      "name": "Diff changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#835f10"
      }
    },
    {
      "name": "GitGutter inserted",
      "scope": "markup.inserted.git_gutter",
      "settings": {
        "foreground": "#4f714b"
      }
    },
    {
      "name": "GitGutter deleted",
      "scope": "markup.deleted.git_gutter",
      "settings": {
        "foreground": "#aa4e55"
      }
    },
    {
      "name": "GitGutter changed",
      "scope": "markup.changed.git_gutter",
      "settings": {
        "foreground": "#835f10"
      }
    },
    {
      "name": "GitGutter untracked",
      "scope": "markup.untracked.git_gutter",
      "settings": {
        "foreground": "#888177"
      }
    },
    {
      "name": "GitGutter ignored",
      "scope": "markup.ignored.git_gutter",
      "settings": {
        "foreground": "#888177"
      }
    }
  ],
