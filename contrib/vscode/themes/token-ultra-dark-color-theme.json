{
  "name": "Token Ultra Dark",
  "type": "dark",
  "colors": {
    "focusBorder": "#d98262",
    "foreground": "#e7e2d9",
    "descriptionForeground": "#979189",
    "errorForeground": "#cf7778",
    "textLink.foreground": "#829db2",
    "textLink.activeForeground": "#d98262",
    "selection.background": "#3c3b36",
    "icon.foreground": "#d4cfc6",
    "sash.hoverBorder": "#d98262",
    "editor.background": "#272724",
    "editor.foreground": "#e7e2d9",
    "editorLineNumber.foreground": "#585855",
    "editorLineNumber.activeForeground": "#979189",
    "editorCursor.foreground": "#e7e2d9",
    "editor.selectionBackground": "#3c3b36",
    "editor.inactiveSelectionBackground": "#30302c",
    "editor.lineHighlightBackground": "#38383540",
    "editor.findMatchBackground": "#4d4231",
    "editor.findMatchHighlightBackground": "#4d423180",
    "editorWhitespace.foreground": "#65615c80",
    "editorIndentGuide.background1": "#65615c40",
    "editorIndentGuide.activeBackground1": "#97918980",
    "editorBracketMatch.background": "#383835",
    "editorBracketMatch.border": "#d98262",
    "editorGutter.addedBackground": "#86a17a",
    "editorGutter.modifiedBackground": "#c7a35b",
    "editorGutter.deletedBackground": "#cf7778",
    "diffEditor.insertedTextBackground": "#1e3524",
    "diffEditor.removedTextBackground": "#3c2024",
    "editorError.foreground": "#cf7778",
    "editorWarning.foreground": "#c7a35b",
    "editorInfo.foreground": "#829db2",
    "editorHint.foreground": "#6ba8a8",
    "activityBar.background": "#212120",
    "activityBar.foreground": "#e7e2d9",
    "activityBar.inactiveForeground": "#979189",
    "activityBarBadge.background": "#d98262",
    "activityBarBadge.foreground": "#272724",
    "sideBar.background": "#212120",
    "sideBar.foreground": "#d4cfc6",
    "sideBarTitle.foreground": "#e7e2d9",
    "sideBarSectionHeader.background": "#272724",
    "list.activeSelectionBackground": "#3c3b36",
    "list.activeSelectionForeground": "#e7e2d9",
    "list.inactiveSelectionBackground": "#30302c",
    "list.hoverBackground": "#30302c",
    "list.focusBackground": "#30302c",
    "quickInput.background": "#212120",
    "quickInput.foreground": "#e7e2d9",
    "quickInputList.focusBackground": "#3c3b36",
    "panel.background": "#212120",
    "panel.border": "#383835",
    "panelTitle.activeForeground": "#e7e2d9",
    "panelTitle.inactiveForeground": "#979189",
    "statusBar.background": "#212120",
    "statusBar.foreground": "#d4cfc6",
    "statusBar.noFolderBackground": "#212120",
    "statusBar.debuggingBackground": "#a68bbf",
    "titleBar.activeBackground": "#212120",
    "titleBar.activeForeground": "#e7e2d9",
    "titleBar.inactiveBackground": "#1d1d1c",
    "titleBar.inactiveForeground": "#979189",
    "tab.activeBackground": "#272724",
    "tab.activeForeground": "#e7e2d9",
    "tab.inactiveBackground": "#212120",
    "tab.inactiveForeground": "#979189",
    "tab.border": "#212120",
    "terminal.background": "#272724",
    "terminal.foreground": "#e7e2d9",
    "terminalCursor.foreground": "#e7e2d9",
    "terminal.selectionBackground": "#3c3b36",
    "terminal.ansiBlack": "#1d1d1c",
    "terminal.ansiRed": "#cf7778",
    "terminal.ansiGreen": "#86a17a",
    "terminal.ansiYellow": "#c7a35b",
    "terminal.ansiBlue": "#829db2",
    "terminal.ansiMagenta": "#a68bbf",
    "terminal.ansiCyan": "#6ba8a8",
    "terminal.ansiWhite": "#d4cfc6",
    "terminal.ansiBrightBlack": "#65615c",
    "terminal.ansiBrightRed": "#d98262",
    "terminal.ansiBrightGreen": "#98bf95",
    "terminal.ansiBrightYellow": "#c79b5b",
    "terminal.ansiBrightBlue": "#96b8d3",
    "terminal.ansiBrightMagenta": "#bea5d4",
    "terminal.ansiBrightCyan": "#88c0c0",
    "terminal.ansiBrightWhite": "#e7e2d9"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": "comment, punctuation.definition.comment",
      "settings": {
        "foreground": "#979189",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keyword",
      "scope": "keyword, keyword.control, keyword.other, storage.modifier",
      "settings": {
        "foreground": "#c79b5b"
      }
    },
    {
      "name": "Operator",
      "scope": "keyword.operator",
      "settings": {
        "foreground": "#d4cfc6"
      }
    },
    {
      "name": "Function definition",
      "scope": "entity.name.function, meta.function.definition entity.name",
      "settings": {
        "foreground": "#d98262",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function call",
      "scope": "meta.function-call, variable.function",
      "settings": {
        "foreground": "#d98262"
      }
    },
    {
      "name": "Built-in function",
      "scope": "support.function",
      "settings": {
        "foreground": "#d4cfc6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": "string, punctuation.definition.string",
      "settings": {
        "foreground": "#72a59e"
      }
    },
    {
      "name": "Literal",
      "scope": "constant, constant.language, constant.numeric, variable.other.constant",
      "settings": {
        "foreground": "#72a59e"
      }
    },
    {
      "name": "Type definition",
      "scope": "entity.name.type, entity.name.class, entity.name.type.class",
      "settings": {
        "foreground": "#d98262",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Type reference",
      "scope": "storage.type, support.type, support.class, entity.other.inherited-class",
      "settings": {
        "foreground": "#d4cfc6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Module",
      "scope": "entity.name.namespace, entity.name.type.module, support.module",
      "settings": {
        "foreground": "#d4cfc6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Preprocessor",
      "scope": "keyword.control.import, keyword.control.export, keyword.control.directive, keyword.preprocessor, keyword.other.import, keyword.other.package, keyword.other.using",
      "settings": {
        "foreground": "#c79b5b"
      }
    },
    {
      "name": "Macro",
      "scope": "entity.name.function.preprocessor",
      "settings": {
        "foreground": "#c79b5b"
      }
    },
    {
      "name": "Tag",
      "scope": "entity.name.tag",
      "settings": {
        "foreground": "#d4cfc6"
      }
    },
    {
      "name": "Tag attribute",
      "scope": "entity.other.attribute-name",
      "settings": {
        "foreground": "#d4cfc6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Attribute",
      "scope": "meta.annotation, storage.type.annotation",
      "settings": {
        "foreground": "#d4cfc6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Label",
      "scope": "entity.name.label, constant.other.label",
      "settings": {
        "foreground": "#c79b5b"
      }
    },
    {
      "name": "Built-in symbol",
      "scope": "variable.language",
      "settings": {
        "foreground": "#d4cfc6",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Debug",
      "scope": "keyword.other.debugger",
      "settings": {
        "foreground": "#c79b5b"
      }
    },
    {
      "name": "Exception",
      "scope": "keyword.control.exception, keyword.control.trycatch",
      "settings": {
        "foreground": "#c79b5b"
      }
    },
    {
      "name": "Identifier",
      "scope": "variable, support.variable, meta.definition.variable",
      "settings": {
        "foreground": "#e7e2d9"
      }
    },
    {
      "name": "Property",
      "scope": "variable.object.property, variable.other.property, variable.other.member, meta.object-literal.key",
      "settings": {
        "foreground": "#e7e2d9"
      }
    },
    {
      "name": "Delimiter",
      "scope": "punctuation, meta.brace, meta.delimiter, meta.bracket",
      "settings": {
        "foreground": "#d4cfc6"
      }
    },
    {
      "name": "Parameter",
      "scope": "variable.parameter",
      "settings": {
        "foreground": "#d4cfc6"
      }
    },
    {
      "name": "Heading 1",
      "scope": "heading.1.markdown, markup.heading.setext.1.markdown",
      "settings": {
        "foreground": "#d98262",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 2",
      "scope": "heading.2.markdown, markup.heading.setext.2.markdown",
      "settings": {
        "foreground": "#c79b5b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 3",
      "scope": "heading.3.markdown",
      "settings": {
        "foreground": "#829db2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 4",
      "scope": "heading.4.markdown",
      "settings": {
        "foreground": "#d98262",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 5",
      "scope": "heading.5.markdown",
      "settings": {
        "foreground": "#c79b5b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading 6",
      "scope": "heading.6.markdown",
      "settings": {
        "foreground": "#829db2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Heading delimiter",
      "scope": "punctuation.definition.heading.markdown",
      "settings": {
        "foreground": "#979189"
      }
    },
    {
      "name": "Markup link",
      "scope": "markup.underline.link, string.other.link",
      "settings": {
        "foreground": "#829db2",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup link text",
      "scope": "string.other.link.title.markdown, constant.other.reference.link.markdown",
      "settings": {
        "foreground": "#829db2",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup code",
      "scope": "markup.fenced_code.block.markdown, markup.inline.raw.string.markdown, markup.raw",
      "settings": {
        "foreground": "#72a59e"
      }
    },
    {
      "name": "Markup code delimiter",
      "scope": "punctuation.definition.markdown, punctuation.definition.raw.markdown",
      "settings": {
        "foreground": "#979189"
      }
    },
    {
      "name": "Markup list",
      "scope": "punctuation.definition.list.begin.markdown, markup.list",
      "settings": {
        "foreground": "#c79b5b"
      }
    },
    {
      "name": "Markup bold",
      "scope": "markup.bold",
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": "markup.italic",
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup bold italic",
      "scope": "markup.bold markup.italic, markup.italic markup.bold",
      "settings": {
        "fontStyle": "italic bold"
      }
    },
    {
      "name": "Markup quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "#979189",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Diff added",
      "scope": "markup.inserted, meta.diff.header.to-file",
      "settings": {
        "foreground": "#86a17a"
      }
    },
    {
      "name": "Diff deleted",
      "scope": "markup.deleted, meta.diff.header.from-file",
      "settings": {
        "foreground": "#cf7778"
      }
    },
    {
      "name": "Diff changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "#c7a35b"
      }
    },
    {
      "name": "GitGutter inserted",
      "scope": "markup.inserted.git_gutter",
      "settings": {
        "foreground": "#86a17a"
      }
    },
    {
      "name": "GitGutter deleted",
      "scope": "markup.deleted.git_gutter",
      "settings": {
        "foreground": "#cf7778"
      }
    },
    {
      "name": "GitGutter changed",
      "scope": "markup.changed.git_gutter",
      "settings": {
        "foreground": "#c7a35b"
      }
    },
    {
      "name": "GitGutter untracked",
      "scope": "markup.untracked.git_gutter",
      "settings": {
        "foreground": "#65615c"
      }
    },
    {
      "name": "GitGutter ignored",
      "scope": "markup.ignored.git_gutter",
      "settings": {
        "foreground": "#65615c"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": {
      "foreground": "#d4cfc6",
      "italic": true
    },
    "enum": {
      "foreground": "#d4cfc6",
      "italic": true
    },
    "interface": {
      "foreground": "#d4cfc6",
      "italic": true
    },
    "struct": {
      "foreground": "#d4cfc6",
      "italic": true
    },
    "type": {
      "foreground": "#d4cfc6",
      "italic": true
    },
    "typeParameter": {
      "foreground": "#d4cfc6",
      "italic": true
    },
    "namespace": {
      "foreground": "#d4cfc6",
      "italic": true
    },
    "function": "#d98262",
    "method": "#d98262",
    "macro": "#c79b5b",
    "keyword": "#c79b5b",
    "string": "#72a59e",
    "number": "#72a59e",
    "enumMember": "#72a59e",
    "variable.readonly": "#72a59e",
    "property.readonly": "#72a59e",
    "parameter": "#d4cfc6",
    "*.deprecated": {
      "strikethrough": true
    },
    "*.readonly": {
      "foreground": "#72a59e"
    },
    "*.async": {
      "italic": true
    },
    "*.static": {
      "italic": true
    },
    "*.abstract": {
      "italic": true
    },
    "*.defaultLibrary": {
      "foreground": "#d4cfc6",
      "italic": true
    },
    "*.declaration": {
      "bold": true
    },
    "*.definition": {
      "bold": true
    },
    "type.declaration": {
      "foreground": "#d98262",
      "bold": true,
      "italic": false
    },
    "type.definition": {
      "foreground": "#d98262",
      "bold": true,
      "italic": false
    },
    "class.declaration": {
      "foreground": "#d98262",
      "bold": true,
      "italic": false
    },
    "class.definition": {
      "foreground": "#d98262",
      "bold": true,
      "italic": false
    },
    "enum.declaration": {
      "foreground": "#d98262",
      "bold": true,
      "italic": false
    },
    "enum.definition": {
      "foreground": "#d98262",
      "bold": true,
      "italic": false
    },
    "interface.declaration": {
      "foreground": "#d98262",
      "bold": true,
      "italic": false
    },
    "interface.definition": {
      "foreground": "#d98262",
      "bold": true,
      "italic": false
    },
    "struct.declaration": {
      "foreground": "#d98262",
      "bold": true,
      "italic": false
    },
    "struct.definition": {
      "foreground": "#d98262",
      "bold": true,
      "italic": false
    },
    "typeParameter.declaration": {
      "foreground": "#d98262",
      "bold": true,
      "italic": false
    },
    "typeParameter.definition": {
      "foreground": "#d98262",
      "bold": true,
      "italic": false
    },
    "function.declaration": {
      "foreground": "#d98262",
      "bold": true,
      "italic": false
    },
    "function.definition": {
      "foreground": "#d98262",
      "bold": true,
      "italic": false
    },
    "method.declaration": {
      "foreground": "#d98262",
      "bold": true,
      "italic": false
    },
    "method.definition": {
      "foreground": "#d98262",
      "bold": true,
      "italic": false
    }
  }
}
