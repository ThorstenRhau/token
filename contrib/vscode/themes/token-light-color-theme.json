    "descriptionForeground": "#504b44",
    "errorForeground": "#ad5253",
    "textLink.foreground": "#315270",
    "textLink.activeForeground": "#863716",
    "selection.background": "#dddcd6",
    "icon.foreground": "#565141",
    "sash.hoverBorder": "#863716",
    "editor.background": "#faf9f5",
