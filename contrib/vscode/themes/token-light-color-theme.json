    "panelTitle.inactiveForeground": "#504b44",
    "statusBar.background": "#f6f5f1",
    "statusBar.foreground": "#565141",
    "statusBar.noFolderBackground": "#f6f5f1",
    "statusBar.debuggingBackground": "#573c72",
    "titleBar.activeBackground": "#f6f5f1",
    "titleBar.activeForeground": "#323128",
    "titleBar.inactiveBackground": "#ecebe7",
    "titleBar.inactiveForeground": "#504b44",
    "tab.activeBackground": "#faf9f5",
    "tab.activeForeground": "#323128",
    "tab.inactiveBackground": "#f6f5f1",
    "tab.inactiveForeground": "#504b44",
    "tab.border": "#f6f5f1",
    "terminal.background": "#faf9f5",
    "terminal.foreground": "#323128",
    "terminalCursor.foreground": "#323128",
    "terminal.selectionBackground": "#dddcd6",
    "terminal.ansiBlack": "#323128",
    "terminal.ansiRed": "#ad5253",
    "terminal.ansiGreen": "#365a33",
    "terminal.ansiYellow": "#857238",
    "terminal.ansiBlue": "#315270",
    "terminal.ansiMagenta": "#573c72",
    "terminal.ansiCyan": "#185b5b",
    "terminal.ansiWhite": "#b4b2ab",
    "terminal.ansiBrightBlack": "#504b44",
    "terminal.ansiBrightRed": "#863716",
    "terminal.ansiBrightGreen": "#274b24",
    "terminal.ansiBrightYellow": "#6d4717",
    "terminal.ansiBrightBlue": "#335471",
    "terminal.ansiBrightMagenta": "#6b5488",
    "terminal.ansiBrightCyan": "#387272",
    "terminal.ansiBrightWhite": "#faf9f5"
