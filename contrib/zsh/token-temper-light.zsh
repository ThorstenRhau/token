# Generated by token colorscheme. Do not edit manually.
# Source this file from your .zshrc to apply token-temper light colors.

# ZLE selection and pasted text
zle_highlight=(${zle_highlight:#region:*})
zle_highlight=(${zle_highlight:#paste:*} "region:fg=#28313A,bg=#DCE2E7" "paste:fg=#28313A,bg=#DCE2E7")

