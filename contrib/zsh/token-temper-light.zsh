# LS_COLORS (GNU ls, tree, zsh completion)
export LS_COLORS='di=1;38;2;0;125;114:ln=38;2;120;69;167:or=38;2;190;62;80:mi=9;38;2;190;62;80:so=38;2;0;125;114:pi=38;2;137;97;13:ex=38;2;0;125;114:bd=38;2;0;125;114:cd=38;2;0;125;114:su=1;38;2;190;62;80:sg=1;38;2;137;97;13:tw=1;38;2;0;125;114:ow=4;38;2;0;125;114:st=1;38;2;0;125;114'

# LSCOLORS (BSD ls)
export CLICOLOR=1
export LSCOLORS='ExfxcxdxBxgxgxBxDxCxex'

# Completion
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}" "ma=48;2;220;226;231;38;2;40;49;58"
zstyle ':completion:*:descriptions' format '%F{#65717D}-- %d --%f'
zstyle ':completion:*:messages' format '%F{#65717D}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{#BE3E50}-- no matches --%f'

# fzf-tab
zstyle ':fzf-tab:*' fzf-flags \
  '--color=fg:#28313A,bg:#F5F7F8,hl:#007D72' \
  '--color=fg+:#28313A,bg+:#DCE2E7,hl+:#007D72' \
  '--color=border:#828E9A,header:#007D72,gutter:#F5F7F8' \
  '--color=spinner:#7845A7,info:#65717D' \
  '--color=pointer:#007D72,marker:#007D72,prompt:#007D72'
zstyle ':fzf-tab:*' default-color $'\033[38;2;40;49;58m'
zstyle ':fzf-tab:*' group-colors $'\033[38;2;0;125;114m' $'\033[38;2;0;125;114m' $'\033[38;2;120;69;167m' $'\033[38;2;120;69;167m' $'\033[38;2;0;125;114m' $'\033[38;2;0;125;114m' $'\033[38;2;137;97;13m' $'\033[38;2;190;62;80m'

