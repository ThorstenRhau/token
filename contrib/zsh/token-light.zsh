# Generated by token colorscheme. Do not edit manually.
# Source this file from your .zshrc to apply token light colors.

# ZLE selection and pasted text
zle_highlight=(${zle_highlight:#region:*})
zle_highlight=(${zle_highlight:#paste:*} "region:fg=#323128,bg=#dddcd6" "paste:fg=#323128,bg=#dddcd6")

