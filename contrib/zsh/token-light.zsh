# LS_COLORS (GNU ls, tree, zsh completion)
export LS_COLORS='di=1;38;2;49;82;112:ln=38;2;87;60;114:or=38;2;173;82;83:mi=9;38;2;173;82;83:so=38;2;54;90;51:pi=38;2;133;114;56:ex=38;2;134;55;22:bd=38;2;24;91;91:cd=38;2;24;91;91:su=1;38;2;173;82;83:sg=1;38;2;133;114;56:tw=1;38;2;54;90;51:ow=4;38;2;49;82;112:st=1;38;2;49;82;112'

# LSCOLORS (BSD ls)
export CLICOLOR=1
export LSCOLORS='ExfxcxdxBxgxgxBxDxCxex'

# Completion
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}" "ma=48;2;221;220;214;38;2;50;49;40"
zstyle ':completion:*:descriptions' format '%F{#504b44}-- %d --%f'
zstyle ':completion:*:messages' format '%F{#504b44}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{#ad5253}-- no matches --%f'

# fzf-tab
zstyle ':fzf-tab:*' fzf-flags \
  '--color=fg:#323128,bg:#faf9f5,hl:#863716' \
  '--color=fg+:#323128,bg+:#dddcd6,hl+:#863716' \
  '--color=border:#524e46,header:#315270,gutter:#faf9f5' \
  '--color=spinner:#6d4717,info:#504b44' \
  '--color=pointer:#863716,marker:#365a33,prompt:#863716'
zstyle ':fzf-tab:*' default-color $'\033[38;2;50;49;40m'
zstyle ':fzf-tab:*' group-colors $'\033[38;2;49;82;112m' $'\033[38;2;54;90;51m' $'\033[38;2;109;71;23m' $'\033[38;2;87;60;114m' $'\033[38;2;24;91;91m' $'\033[38;2;134;55;22m' $'\033[38;2;133;114;56m' $'\033[38;2;173;82;83m'

