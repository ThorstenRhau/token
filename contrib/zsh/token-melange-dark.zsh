# Generated by token colorscheme. Do not edit manually.
# Source this file from your .zshrc to apply token-melange dark colors.

# ZLE selection and pasted text
zle_highlight=(${zle_highlight:#region:*})
zle_highlight=(${zle_highlight:#paste:*} "region:fg=#c9beb2,bg=#403a36" "paste:fg=#c9beb2,bg=#403a36")

# fast-syntax-highlighting
