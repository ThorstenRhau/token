# LS_COLORS (GNU ls, tree, zsh completion)
export LS_COLORS='di=1;38;2;162;169;208:ln=38;2;213;158;198:or=38;2;200;139;143:mi=9;38;2;200;139;143:so=38;2;132;184;148:pi=38;2;193;154;71:ex=38;2;205;164;79:bd=38;2;134;174;177:cd=38;2;134;174;177:su=1;38;2;200;139;143:sg=1;38;2;193;154;71:tw=1;38;2;132;184;148:ow=4;38;2;162;169;208:st=1;38;2;162;169;208'

# LSCOLORS (BSD ls)
export CLICOLOR=1
export LSCOLORS='ExfxcxdxBxgxgxBxDxCxex'

# Completion
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}" "ma=48;2;64;58;54;38;2;201;190;178"
zstyle ':completion:*:descriptions' format '%F{#af997d}-- %d --%f'
zstyle ':completion:*:messages' format '%F{#af997d}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{#c88b8f}-- no matches --%f'

# fzf-tab
zstyle ':fzf-tab:*' fzf-flags \
  '--color=fg:#c9beb2,bg:#292522,hl:#cda44f' \
  '--color=fg+:#c9beb2,bg+:#403a36,hl+:#cda44f' \
  '--color=border:#988573,header:#a2a9d0,gutter:#292522' \
  '--color=spinner:#fcc493,info:#af997d' \
  '--color=pointer:#cda44f,marker:#84b894,prompt:#cda44f'
zstyle ':fzf-tab:*' default-color $'\033[38;2;201;190;178m'
zstyle ':fzf-tab:*' group-colors $'\033[38;2;162;169;208m' $'\033[38;2;132;184;148m' $'\033[38;2;252;196;147m' $'\033[38;2;213;158;198m' $'\033[38;2;134;174;177m' $'\033[38;2;205;164;79m' $'\033[38;2;193;154;71m' $'\033[38;2;200;139;143m'

