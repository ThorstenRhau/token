# Generated by token colorscheme. Do not edit manually.
# Source this file from your .zshrc to apply token-ultra light colors.

# ZLE selection and pasted text
zle_highlight=(${zle_highlight:#region:*})
zle_highlight=(${zle_highlight:#paste:*} "region:fg=#292a24,bg=#dedbd3" "paste:fg=#292a24,bg=#dedbd3")

