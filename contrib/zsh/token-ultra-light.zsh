# LS_COLORS (GNU ls, tree, zsh completion)
export LS_COLORS='di=1;38;2;83;111;136:ln=38;2;124;97;154:or=38;2;170;78;85:mi=9;38;2;170;78;85:so=38;2;79;113;75:pi=38;2;131;95;16:ex=38;2;164;78;49:bd=38;2;45;108;108:cd=38;2;45;108;108:su=1;38;2;170;78;85:sg=1;38;2;131;95;16:tw=1;38;2;79;113;75:ow=4;38;2;83;111;136:st=1;38;2;83;111;136'

# LSCOLORS (BSD ls)
export CLICOLOR=1
export LSCOLORS='ExfxcxdxBxgxgxBxDxCxex'

# Completion
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}" "ma=48;2;222;219;211;38;2;41;42;36"
zstyle ':completion:*:descriptions' format '%F{#6d675f}-- %d --%f'
zstyle ':completion:*:messages' format '%F{#6d675f}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{#aa4e55}-- no matches --%f'

# fzf-tab
zstyle ':fzf-tab:*' fzf-flags \
  '--color=fg:#292a24,bg:#fbf9f4,hl:#a44e31' \
  '--color=fg+:#292a24,bg+:#dedbd3,hl+:#a44e31' \
  '--color=border:#888177,header:#536f88,gutter:#fbf9f4' \
  '--color=spinner:#87601b,info:#6d675f' \
  '--color=pointer:#a44e31,marker:#4f714b,prompt:#a44e31'
zstyle ':fzf-tab:*' default-color $'\033[38;2;41;42;36m'
zstyle ':fzf-tab:*' group-colors $'\033[38;2;83;111;136m' $'\033[38;2;79;113;75m' $'\033[38;2;135;96;27m' $'\033[38;2;124;97;154m' $'\033[38;2;45;108;108m' $'\033[38;2;164;78;49m' $'\033[38;2;131;95;16m' $'\033[38;2;170;78;85m'

