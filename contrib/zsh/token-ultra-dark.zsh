# Generated by token colorscheme. Do not edit manually.
# Source this file from your .zshrc to apply token-ultra dark colors.

# ZLE selection and pasted text
zle_highlight=(${zle_highlight:#region:*})
zle_highlight=(${zle_highlight:#paste:*} "region:fg=#e7e2d9,bg=#3c3b36" "paste:fg=#e7e2d9,bg=#3c3b36")

