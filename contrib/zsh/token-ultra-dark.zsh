# LS_COLORS (GNU ls, tree, zsh completion)
export LS_COLORS='di=1;38;2;130;157;178:ln=38;2;166;139;191:or=38;2;207;119;120:mi=9;38;2;207;119;120:so=38;2;134;161;122:pi=38;2;199;163;91:ex=38;2;217;130;98:bd=38;2;107;168;168:cd=38;2;107;168;168:su=1;38;2;207;119;120:sg=1;38;2;199;163;91:tw=1;38;2;134;161;122:ow=4;38;2;130;157;178:st=1;38;2;130;157;178'

# LSCOLORS (BSD ls)
export CLICOLOR=1
export LSCOLORS='ExfxcxdxBxgxgxBxDxCxex'

# Completion
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}" "ma=48;2;60;59;54;38;2;231;226;217"
zstyle ':completion:*:descriptions' format '%F{#979189}-- %d --%f'
zstyle ':completion:*:messages' format '%F{#979189}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{#cf7778}-- no matches --%f'

# fzf-tab
zstyle ':fzf-tab:*' fzf-flags \
  '--color=fg:#e7e2d9,bg:#272724,hl:#d98262' \
  '--color=fg+:#e7e2d9,bg+:#3c3b36,hl+:#d98262' \
  '--color=border:#65615c,header:#829db2,gutter:#272724' \
  '--color=spinner:#c79b5b,info:#979189' \
  '--color=pointer:#d98262,marker:#86a17a,prompt:#d98262'
zstyle ':fzf-tab:*' default-color $'\033[38;2;231;226;217m'
zstyle ':fzf-tab:*' group-colors $'\033[38;2;130;157;178m' $'\033[38;2;134;161;122m' $'\033[38;2;199;155;91m' $'\033[38;2;166;139;191m' $'\033[38;2;107;168;168m' $'\033[38;2;217;130;98m' $'\033[38;2;199;163;91m' $'\033[38;2;207;119;120m'

