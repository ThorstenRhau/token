# LS_COLORS (GNU ls, tree, zsh completion)
export LS_COLORS='di=1;38;2;124;193;220:ln=38;2;198;157;232:or=38;2;221;131;132:mi=9;38;2;221;131;132:so=38;2;140;187;98:pi=38;2;194;176;64:ex=38;2;232;154;73:bd=38;2;207;156;112:cd=38;2;207;156;112:su=1;38;2;221;131;132:sg=1;38;2;194;176;64:tw=1;38;2;140;187;98:ow=4;38;2;124;193;220:st=1;38;2;124;193;220'

# LSCOLORS (BSD ls)
export CLICOLOR=1
export LSCOLORS='ExfxcxdxBxgxgxBxDxCxex'

# Completion
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}" "ma=48;2;60;59;54;38;2;201;192;177"
zstyle ':completion:*:descriptions' format '%F{#a69c91}-- %d --%f'
zstyle ':completion:*:messages' format '%F{#a69c91}-- %d --%f'
zstyle ':completion:*:warnings' format '%F{#dd8384}-- no matches --%f'

# fzf-tab
zstyle ':fzf-tab:*' fzf-flags \
  '--color=fg:#c9c0b1,bg:#272724,hl:#e89a49' \
  '--color=fg+:#c9c0b1,bg+:#3c3b36,hl+:#e89a49' \
  '--color=border:#91887d,header:#7cc1dc,gutter:#272724' \
  '--color=spinner:#f8c88f,info:#a69c91' \
  '--color=pointer:#e89a49,marker:#8cbb62,prompt:#e89a49'
zstyle ':fzf-tab:*' default-color $'\033[38;2;201;192;177m'
zstyle ':fzf-tab:*' group-colors $'\033[38;2;124;193;220m' $'\033[38;2;140;187;98m' $'\033[38;2;248;200;143m' $'\033[38;2;198;157;232m' $'\033[38;2;207;156;112m' $'\033[38;2;232;154;73m' $'\033[38;2;194;176;64m' $'\033[38;2;221;131;132m'

