# Generated by token colorscheme. Do not edit manually.
# Source this file from your .zshrc to apply token-temper dark colors.

# ZLE selection and pasted text
zle_highlight=(${zle_highlight:#region:*})
zle_highlight=(${zle_highlight:#paste:*} "region:fg=#C3C8CC,bg=#3A414A" "paste:fg=#C3C8CC,bg=#3A414A")

# fast-syntax-highlighting
typeset -gA FAST_HIGHLIGHT_STYLES
